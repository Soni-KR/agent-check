# Optional: leave DATABASE_URL unset for a local SQLite file.
# With the PostgreSQL container in compose.yaml:
# DATABASE_URL=postgresql+psycopg://agentcheck:local-demo-only@localhost:5433/agentcheck

# Free local inference (default). Start Ollama and install this model once.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434

# Optional paid provider: set LLM_PROVIDER=openai and your key to opt in.
# OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
